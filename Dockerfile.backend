# syntax=docker/dockerfile:1
# AeroCascade Authoritative Causal Engine Container
# Pinned Base: Python 3.12 Slim (Debian Bookworm)
FROM python:3.12-slim

LABEL org.opencontainers.image.title="AeroCascade Causal Engine Backend" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.vendor="AeroCascade" \
      org.opencontainers.image.licenses="Commercial"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENTERPRISE_MODE=true \
    AEROCASCADE_DB_PATH=/var/lib/aerocascade/data/aerocascade.db \
    AEROCASCADE_BACKUP_DIR=/var/lib/aerocascade/backups

WORKDIR /app

# Create unprivileged system group and user
RUN groupadd -g 10001 aerocascade && \
    useradd -u 10001 -g aerocascade -s /bin/sh -M aerocascade && \
    mkdir -p /var/lib/aerocascade/data /var/lib/aerocascade/backups /tmp && \
    chown -R 10001:10001 /var/lib/aerocascade /tmp

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application backend package
COPY --chown=10001:10001 backend/ ./backend/

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8000/api/health")' || exit 1

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
